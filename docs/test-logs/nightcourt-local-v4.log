+}
+
+.session p {
+    color: var(--warm-ivory);
+}
+
+.session button {
+    background-color: var(--tennis-ball-yellow);
+    color: var(--near-black);
+    border: none;
+    padding: 0.75rem 1.5rem;
+    border-radius: 4px;
+    cursor: pointer;
+    transition: background-color 0.3s, color 0.3s;
+}
+
+.session button:hover {
+    background-color: var(--near-black);
+    color: var(--tennis-ball-yellow);
+}
+
+/* BOOKING SUMMARY */
+#booking-summary {
+    margin-top: 1rem;
