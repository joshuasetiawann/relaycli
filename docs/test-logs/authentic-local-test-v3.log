+  const selectedDay = document.getElementById('selected-day');
+  const selectedTime = document.getElementById('selected-time');
+  const selectedCapacity = document.getElementById('selected-capacity');
+
+  sessionCards.forEach(card => {
+    card.querySelector('.btn-select').addEventListener('click', function() {
+      const day = card.querySelector('.session-day').textContent;
+      const time = card.querySelector('.session-time').textContent;
+      const capacity = card.querySelector('.session-capacity').textContent;
+
+      selectedDay.textContent = day;
+      selectedTime.textContent = time;
+      selectedCapacity.textContent = capacity;
+
